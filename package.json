{
  "name": "finacplus-playwright-assignment",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --debug",
    "report:playwright": "playwright show-report",
    "report:allure": "allure awesome allure-results --single-file --output allure-report/single-file",
    "report:allure:open": "allure open allure-report/single-file",
    "report:allure:view": "npm run report:allure && npm run report:allure:open",
    "clean:allure": "node -e \"require('node:fs').rmSync('allure-results', { recursive: true, force: true })\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepetibalaji/finacplus-playwright-assignment.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pepetibalaji/finacplus-playwright-assignment/issues"
  },
  "homepage": "https://github.com/pepetibalaji/finacplus-playwright-assignment#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "allure": "^3.19.1",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.5"
  }
}